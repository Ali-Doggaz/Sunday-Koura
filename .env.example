DATABASE_URL=postgres://postgres:postgres@localhost:5433/sunday_koura

# Better Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth app (see DEPLOY.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails that become admins on first sign-in
ADMIN_EMAILS=

# Time zone used to display game times
APP_TIMEZONE=Europe/Paris

# Test-only email sign-in. NEVER set this in production.
E2E_TEST_LOGIN=false
